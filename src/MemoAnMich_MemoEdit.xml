    <TopLevelControl name="MAM_MemoEdit_Dialog" mouseEnabled="true" movable="true" hidden="true" allowBringToTop="true" tier="HIGH">
      <Dimensions x="1390" y="750" />
      <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER" offsetX="0" offsetY="0" />

      <Controls>
        <Backdrop name="$(parent)_BG" inherits="ZO_DefaultBackdrop" centerColor="FFFFFFFF" />

        <Control name="$(parent)_Header" hidden="false" resizeToFitConstrains="X">
          <Dimensions y="30" />
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="0" />
          <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="0" offsetY="0" />

          <Controls>
            <Button name="$(parent)_Hide">
              <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="-3" offsetY="3" />
              <OnMouseUp>MemoAnMich.MemoEdit:ToggleWindow()</OnMouseUp>
              <Dimensions x="25" y="25" />
              <Textures normal="/esoui/art/buttons/decline_up.dds" pressed="/esoui/art/buttons/decline_down.dds" mouseOver="/esoui/art/buttons/decline_over.dds" />
            </Button>
            <Label name="$(parent)_Title" font="$(ANTIQUE_FONT)|30" text="MAM_MEMOEDIT_DIALOG_TITLE" horizontalAlignment="CENTER" verticalAlignment="CENTER">
              <Dimensions y="30" />
              <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="0" />
              <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="0" offsetY="0" />
            </Label>
            <Control name="$(parent)_CharList" inherits="ZO_ComboBox MAM_MemoEdit_TooltipTarget" tier="HIGH">
              <Dimensions x="250" y="25" />
              <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="6" offsetY="6" />
            </Control>
          </Controls>
        </Control>

        <Control name="$(parent)_Body" hidden="false" resizeToFitDescendents="true">
          <Anchor point="TOPLEFT" relativeTo="$(parent)_Header" relativePoint="BOTTOMLEFT" offsetX="2" offsetY="12" />
          <Anchor point="TOPRIGHT" relativeTo="$(parent)_Header" relativePoint="BOTTOMRIGHT" offsetX="0" offsetY="12" />

          <Controls>
            <Label name="$(parent)_TextBox_Label" font="$(ANTIQUE_FONT)|16" text="MAM_TEXTBOX" horizontalAlignment="CENTER" verticalAlignment="BOTTOM">
              <Dimensions x="400" y="24" />
              <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="3" />
            </Label>

<!-- resizeToFitConstrains="X"
resizeToFitDescendents="true"
excludeFromResizeToFitExtents
 -->

            <Backdrop name="$(parent)_BD" tier="HIGH" inherits="ZO_EditBackdrop">
              <Anchor point="TOPLEFT" relativeTo="$(parent)_TextBox_Label" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="0" />
              <Anchor point="TOPRIGHT" relativeTo="$(parent)_TextBox_Label" relativePoint="BOTTOMRIGHT" offsetX="16" offsetY="0" />
              <Dimensions x="250" y="200"/>
              <Controls>
                <EditBox name="$(grandparent)_TextBox_Control" inherits="ZO_DefaultEditMultiLineForBackdrop ZO_EditDefaultText" />
              </Controls>
            </Backdrop>

          </Controls>
        </Control>

        <Control name="$(parent)_Footer" hidden="false" resizeToFitConstrains="X">
          <Dimensions y="30" />
          <Anchor point="BOTTOMLEFT" relativeTo="$(parent)" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="0" />
          <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" offsetX="0" offsetY="0" />

          <Controls>
            <Button name="$(parent)_Close" text="Close">
              <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="-3" offsetY="3" />
              <OnMouseUp>MemoAnMich.MemoEdit:ToggleWindow()</OnMouseUp>
              <Dimensions x="25" y="25" />
              <Textures normal="/esoui/art/buttons/decline_up.dds" pressed="/esoui/art/buttons/decline_down.dds" mouseOver="/esoui/art/buttons/decline_over.dds" />
            </Button>
            <Button name="$(parent)_Cancel" text="Cancel">
              <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="-3" offsetY="3" />
              <!-- 
              <OnMouseUp>MemoAnMich.MemoEdit:ToggleWindow()</OnMouseUp>
               -->
               <!-- 
              <Dimensions x="25" y="25" />
              <Textures normal="/esoui/art/buttons/decline_up.dds" pressed="/esoui/art/buttons/decline_down.dds" mouseOver="/esoui/art/buttons/decline_over.dds" />
                -->
                
            </Button>
          </Controls>
        </Control>


      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>
